# Root-level .gitignore for the rhinocash-system repository.
# rhinocash-backend/.gitignore also exists and covers the same paths
# relative to that folder — both are kept so the rules apply correctly
# regardless of which directory git is invoked from.

rhinocash-backend/data/*.db
rhinocash-backend/data/*.db-wal
rhinocash-backend/data/*.db-shm
rhinocash-backend/data/.session_secret
rhinocash-backend/data/.mpesa_encryption_key
rhinocash-backend/data/uploads/*
!rhinocash-backend/data/uploads/.gitkeep
rhinocash-backend/node_modules/
rhinocash-backend/.env

# Generated test artifacts — regenerated by test/run-frontend.sh, never
# hand-edited, never meant to be committed.
rhinocash-backend/test/frontend-integration.combined.js
rhinocash-app/extracted.js

# Scratch space for rhinocash-backend/test/run-all.sh and
# run-frontend.sh — test database + WAL/SHM sidecars, seed output, and
# server logs. Never the real application database.
rhinocash-backend/test/tmp/

*.tmp
.DS_Store
