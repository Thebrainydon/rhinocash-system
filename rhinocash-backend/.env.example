# Copy to .env and fill in for production. Every one of these has a safe
# default for local development — see README.md — so nothing here is
# required just to run `node server.js` locally.

# ---- Server ----
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.example.com
RATE_LIMIT_PER_MINUTE=180

# ---- Database ----
# Local dev (default): SQLite, no setup needed.
RHINOCASH_DB_PATH=data/rhinocash.db
# Production target: see docs/POSTGRES_MIGRATION.md before setting these —
# src/db.js currently speaks SQLite only; DATABASE_URL is read by the
# Postgres data-access layer described there once that swap is made.
# DATABASE_URL=postgres://user:password@host:5432/rhinocash

# ---- Sessions ----
# Auto-generated and persisted to data/.session_secret if unset. Set this
# explicitly in production so a redeploy doesn't invalidate every session,
# and so the secret lives in your platform's secret manager, not a file.
SESSION_SECRET=

# ---- Initial Admin (seed.js only, optional) ----
INITIAL_ADMIN_EMAIL=admin@rhinocash.co.ke
# Leave unset to have seed.js generate and print a random one (recommended).
INITIAL_ADMIN_PASSWORD=

# ---- M-Pesa (Safaricom Daraja) — see src/integrations/mpesa.js ----
# NORMAL PATH: leave all of these blank. Configure M-Pesa from the running
# app instead, as the Master System Administrator: log in as Admin ->
# System Administration -> Integrations -> M-Pesa Integration. Credentials
# entered there are encrypted (AES-256-GCM) before being stored in the
# database — nothing here needs editing for day-to-day use.
#
# These env vars are an ALTERNATIVE path for teams that prefer classic
# 12-factor secret management (e.g. injecting production credentials via
# your hosting platform's secret manager instead of the database). If
# MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET and MPESA_SHORTCODE are all
# set, they take priority over whatever is saved in the database.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
# Encryption key for M-Pesa credentials stored in the database (32 bytes,
# hex-encoded — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Auto-generated and persisted to data/.mpesa_encryption_key if unset —
# set this explicitly in production, same reasoning as SESSION_SECRET.
MPESA_ENCRYPTION_KEY=

# ---- SMS — see src/integrations/sms.js ----
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ---- Email — see src/integrations/email.js ----
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
