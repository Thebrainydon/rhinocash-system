# Copy to .env and fill in for production. Local development needs at
# minimum DATABASE_URL set to a real PostgreSQL database — see README.md
# "PostgreSQL setup" for how to create one. Everything else below has a
# safe default and is optional.

# ---- Server ----
PORT=4000
NODE_ENV=production
# Web app origin(s) allowed to call this API. Several may be listed,
# separated by commas — e.g. the production domain plus the original
# Render URL kept as a backup:
#   CORS_ORIGIN=https://cbs.rhinocash.co.ke,https://rhinocash-app.onrender.com
# Leave unset in local development to allow any origin.
CORS_ORIGIN=https://your-frontend-domain.example.com
# Public address of the web app, used in emails ("Sign in at …").
# Production: https://cbs.rhinocash.co.ke — leave unset in development.
APP_BASE_URL=
RATE_LIMIT_PER_MINUTE=180
# Where uploaded files (client documents, staff avatars) are written and
# served from. Defaults to data/uploads under the backend directory,
# created automatically on startup if missing.
UPLOAD_DIR=

# ---- Database ----
# Required. Rhinocash V2 is PostgreSQL-only — there is no SQLite fallback.
# The server refuses to start without this set.
DATABASE_URL=postgres://user:password@localhost:5432/rhinocash_dev
# Maximum connections in the pg connection pool. Default 10 is plenty for
# a single-instance deployment; raise it if you run multiple app
# instances against a pooler (PgBouncer/Supabase/Neon).
PGPOOL_MAX=10

# ---- Sessions ----
# Auto-generated and persisted to data/.session_secret if unset. Set this
# explicitly in production so a redeploy doesn't invalidate every session,
# and so the secret lives in your platform's secret manager, not a file.
SESSION_SECRET=

# ---- Initial Admin (seed.js only, optional) ----
INITIAL_ADMIN_EMAIL=admin@rhinocash.co.ke
# Leave unset to have seed.js generate and print a random one (recommended).
INITIAL_ADMIN_PASSWORD=

# ---- M-Pesa (Safaricom Daraja) — see src/integrations/mpesa.js ----
# NORMAL PATH: leave all of these blank. Configure M-Pesa from the running
# app instead, as the Master System Administrator: log in as Admin ->
# System Administration -> Integrations -> M-Pesa Integration. Credentials
# entered there are encrypted (AES-256-GCM) before being stored in the
# database — nothing here needs editing for day-to-day use.
#
# These env vars are an ALTERNATIVE path for teams that prefer classic
# 12-factor secret management (e.g. injecting production credentials via
# your hosting platform's secret manager instead of the database). If
# MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET and MPESA_SHORTCODE are all
# set, they take priority over whatever is saved in the database.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Must point at this BACKEND (the API), not the web app's domain — e.g.
# https://rhinocash-backend.onrender.com/api/mpesa/callback/production
MPESA_CALLBACK_URL=
# Encryption key for M-Pesa credentials stored in the database (32 bytes,
# hex-encoded — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Auto-generated and persisted to data/.mpesa_encryption_key if unset —
# set this explicitly in production, same reasoning as SESSION_SECRET.
MPESA_ENCRYPTION_KEY=

# ---- SMS — see src/integrations/sms.js ----
# Honest status: no real provider adapter is implemented yet (the module
# reports NOT_CONFIGURED and, if you set these without an adapter, raises
# a clear "not implemented" error rather than pretending to send). Setting
# these is only useful once you've added your provider's actual API call.
SMS_PROVIDER=
SMS_API_KEY=

# ---- Email — see src/integrations/email.js ----
# Usually set on Admin > Integrations > Email instead. These are the fallback.
# EMAIL_PROVIDER: sendgrid | mailgun | smtp
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# SMTP mailbox, e.g. Zoho Mail (backend service only — never the static site).
# SMTP_PASSWORD is read by the backend only; it is never sent to browsers,
# returned by the API or written to logs. With 2FA on, use an app-specific password.
# SMTP_HOST=smtppro.zoho.com     (domain mailboxes; smtp.zoho.com for personal @zoho.com)
# SMTP_PORT=587                  (587 = STARTTLS, 465 = SSL)
# SMTP_SECURITY=starttls
# SMTP_USERNAME=hr@rhinocash.co.ke
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
